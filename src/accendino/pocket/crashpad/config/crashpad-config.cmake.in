@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@CRASHPAD_ZLIB_SYSTEM@)
    find_dependency(ZLIB)
endif()
if(@CRASHPAD_NEEDS_CURL@)
    find_dependency(CURL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/crashpad-targets.cmake")

# the installed headers include each other as "util/...", "client/..." but only include/crashpad/client and
# include/crashpad/mini_chromium are exported
set_property(TARGET crashpad::client APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/crashpad")
