#    Detecting or building libyuv
#

libyuv_fromSources = stdBuildFromSourceTest('libyuv', locals(), targetDistribId not in ('Ubuntu', 'Debian', 'RedHat', 'Fedora',))

if libyuv_fromSources:
    libyuv_src = stdGitSourceFromOptions('libyuv', 'https://chromium.googlesource.com/libyuv/libyuv', 'main')
    libyuv_options = ['-DUNIT_TEST=OFF']
    ARTIFACTS += [
        CMakeBuildArtifact('libyuv', [], libyuv_src,
            cmakeOpts=libyuv_options,
            provides=['libyuv-artifact']
        ),
        CMakeBuildArtifact('libyuv-static', [], libyuv_src,
            cmakeOpts=libyuv_options + ['-DBUILD_SHARED_LIBS=OFF'],
            provides=['libyuv-artifact']
        ),
    ]

else:
    libyuv_pkgDeps = {
        UBUNTU_LIKE: ['libyuv-dev'],
        REDHAT_LIKE: ['libyuv-devel'],
    }
    ARTIFACTS += [
        DepsBuildArtifact('libyuv-artifact', [], pkgs=libyuv_pkgDeps)
    ]
