# -*- coding: utf-8 -*-

#
#  Copyright (C) 2025 David Fort <contact@hardening-consulting.com>
#
#    Detecting or building FreeRDP
#
#    handled options with prefix freerdp:
#     * fromSources force build from sources
#     * with_ffmpeg build with FFmpeg
#     * with_fido2 build with webauthn support
#     * with_openh264 build with OpenH264
#     * with_sdl2 build with SDL2 support
#     * with_sdl3 build with SDL3 support
#     * with_yuv build with libyuv support
#     * with_cwalk build with cwalk support
#     * with_dav1d build with dav1d AV1 decoder support (FreeRDP3 only)
#

include('zlib')
include('uriparser')
include('openssl')
include('cjson')
include('libusb')
include('ffmpeg')
include('opus')
include('faac')
include('faad2')
include('openh264')
include('cairo')
include('sdl2')
include('sdl3')
#include('sso-mib')
include('libyuv')
include('cwalk')
include('dav1d')

if checkDistrib('<= Ubuntu 22.04'):
    # we need recent versions of libcbor and libfido2 than the one shipped with the distribution
    libcbor_forceBuild = True
    fido2_forceBuild = True

include('fido2')

freerdp_fromSources = 'freerdp_forceBuild' in locals() or getOption('freerdp.fromSources', targetDistribId in ('Windows', 'mingw', 'Darwin',))


if targetDistribId == 'emscripten':
    # the SDL3 client running in a browser, static and with pthreads, like FreeRDP's scripts/emscripten.sh.
    # The page serving sdl-freerdp.js needs the "Cross-Origin-Opener-Policy: same-origin" and
    # "Cross-Origin-Embedder-Policy: require-corp" headers (SharedArrayBuffer), and a WebSocket to TCP bridge
    # like websockify in front of the RDP server
    include('libressl')

    freerdp_emscripten_opts = [
        '-DWITHOUT_WINPR_3x_DEPRECATED=ON', '-DWITHOUT_FREERDP_3x_DEPRECATED=ON',
        # features without a backend in the browser
        '-DWITH_SERVER=OFF', '-DWITH_SHADOW=OFF', '-DWITH_PROXY=OFF', '-DWITH_SAMPLE=OFF', '-DWITH_PLATFORM_SERVER=OFF',
        '-DWITH_X11=OFF', '-DWITH_WAYLAND=OFF', '-DWITH_ALSA=OFF', '-DWITH_PULSE=OFF', '-DWITH_OSS=OFF', '-DWITH_CUPS=OFF',
        '-DWITH_PCSC=OFF', '-DWITH_KRB5=OFF', '-DWITH_FUSE=OFF', '-DWITH_LIBSYSTEMD=OFF', '-DWITH_FFMPEG=OFF',
        '-DWITH_SWSCALE=OFF', '-DWITH_DSP_FFMPEG=OFF', '-DWITH_OPENH264=OFF', '-DWITH_WEBVIEW=OFF', '-DCHANNEL_URBDRC=OFF',
        '-DWITH_SIMD=OFF', '-DWITH_MANPAGES=OFF', '-DWITH_TIMEZONE_ICU=OFF', '-DWITH_UNICODE_BUILTIN=ON',
        '-DUSE_UNWIND=OFF', '-DWITH_GSTREAMER_1_0=OFF',
        # optional dependencies that are not built for emscripten
        '-DWITH_CAIRO=OFF', '-DWITH_YUV=OFF', '-DWITH_CWALK=OFF', '-DWITH_DAV1D=OFF', '-DWITH_FAAC=OFF', '-DWITH_FAAD2=OFF',
        '-DCHANNEL_RDPEWA=OFF',
        '-DWITH_LIBRESSL=ON', '-DWITH_OPUS=ON', '-DWITH_CJSON_REQUIRED=ON',
        '-DWITH_CLIENT_SDL=ON', '-DWITH_CLIENT_SDL3=ON', '-DWITH_CLIENT_SDL2=OFF', '-DWITH_SDL_LINK_SHARED=OFF',
        '-DWITH_SDL_IMAGE_DIALOGS=OFF',
        # the client runs on the main browser thread and has to yield to the event loop while it waits
        # (ASYNCIFY), the page starts it with callMain()
        '-DCMAKE_EXE_LINKER_FLAGS=-pthread -sASYNCIFY -sASYNCIFY_STACK_SIZE=131072 -sALLOW_MEMORY_GROWTH=1 '
            '-sSTACK_SIZE=1048576 -sPTHREAD_POOL_SIZE=32 -sWEBSOCKET_SUBPROTOCOL=binary -sENVIRONMENT=web,worker '
            '-sINVOKE_RUN=0 -sEXIT_RUNTIME=1 -sFORCE_FILESYSTEM=1 -sEXPORTED_RUNTIME_METHODS=callMain,FS,ENV',
    ]

    ARTIFACTS += [
        CMakeBuildArtifact('freerdp3', ['zlib-artifact', 'uriparser-artifact', 'libressl', 'cjson-artifact', 'opus-artifact',
                                        'SDL3-artifact', 'SDL3_ttf-artifact'],
            GitSource('https://github.com/FreeRDP/FreeRDP.git', 'master'),
            freerdp_emscripten_opts,
            provides=['freerdp', 'freerdp-static', 'freerdp3-artifact'],
            toolchainArtifacts='c,c++'
        ),
    ]

elif freerdp_fromSources:
    FREERDP_opts=['-DWITH_GSTREAMER_1_0=OFF', '-DWITH_SERVER=ON']

    freerdp_ubuntu_debian_common = ['xsltproc', 'libx11-dev', 'libxext-dev', 'libxinerama-dev', 'libxcursor-dev',
                  'libxdamage-dev', 'libxv-dev', 'libxkbfile-dev', 'libasound2-dev', 'libcups2-dev', 'libxml2',
                  'libxml2-dev', 'libxrandr-dev', 'libxi-dev', 'x11proto-scrnsaver-dev']

    freerdp_fedora_redhat_base = ['cups-devel', 'dbus-glib-devel', 'dbus-devel', 'systemd-devel',
      'libuuid-devel', 'pulseaudio-libs-devel', 'gcc-c++', 'libXrandr-devel', 'gsm-devel', 'gcc',
      'libX11-devel', 'libXext-devel', 'libXinerama-devel', 'libXcursor-devel',
      'libXi-devel', 'libXdamage-devel', 'libXv-devel', 'libxkbfile-devel', 'alsa-lib-devel',
       'glib2-devel'
    ]

    freerdp_deps = ['zlib-artifact', 'uriparser-artifact', 'openssl-artifact', 'cjson-artifact', 'libusb-artifact',
                    'opus-artifact',  'faad2-artifact', 'faac-artifact']


    freerdp3_opts = ['-DWITHOUT_FREERDP_3x_DEPRECATED=OFF', '-DWITH_CJSON_REQUIRED=ON']
    freerdp_ffmpeg_opts = ['-DWITH_FFMPEG=OFF', '-DWITH_SWSCALE=OFF']
    if getOption('freerdp.with_ffmpeg', True):
        freerdp_deps.append('ffmpeg-artifact')
        freerdp_ffmpeg_opts = ['-DWITH_FFMPEG=ON', '-DWITH_SWSCALE=ON']

        if distribId in ('Windows',):
            # ffmpeg can't build both static and shared libs with MSVC, so it only builds the DLLs and
            # installs their import libraries in bin/ where FindFFmpeg doesn't look, so name them explicitly
            for comp in ('avcodec', 'avformat', 'avutil', 'swresample', 'swscale'):
                freerdp_ffmpeg_opts += [f'-D{comp.upper()}_LIBRARIES={{prefix_posix}}/bin/{comp}.lib',
                                        f'-D{comp.upper()}_INCLUDE_DIRS={{prefix_posix}}/include']

    if getOption('freerdp.with_openh264', False):
        freerdp_deps.append('openh264-artifact')
        FREERDP_opts.append('-DWITH_OPENH264=ON')
    else:
        FREERDP_opts.append('-DWITH_OPENH264=OFF')

    if getOption('freerdp.with_cairo', True):
        freerdp_deps.append('cairo-artifact')
        FREERDP_opts.append('-DWITH_CAIRO=ON')
    else:
        FREERDP_opts.append('-DWITH_CAIRO=OFF')

    #if getOption('freerdp.with_sso-mib', False):
    #    if targetDistribId not in ('Windows',):
    #        freerdp3_opts.append('-DWITH_SSO_MIB=ON')
    #        freerdp_deps.append('sso-mib-artifact')

    if getOption('freerdp.with_libyuv', True):
        freerdp_deps.append('libyuv-artifact')
        freerdp3_opts.append('-DWITH_YUV=ON')
    else:
        freerdp3_opts.append('-DWITH_YUV=OFF')

    if getOption('freerdp.with_cwalk', True):
        freerdp_deps.append('cwalk-artifact')
        freerdp3_opts.append('-DWITH_CWALK=ON')
    else:
        freerdp3_opts.append('-DWITH_CWALK=OFF')

    if getOption('freerdp.with_dav1d', True):
        freerdp_deps.append('dav1d-artifact')
        freerdp3_opts.append('-DWITH_DAV1D=ON')
    else:
        freerdp3_opts.append('-DWITH_DAV1D=OFF')

    if targetDistribId in ('mingw',):
        FREERDP_opts += ['-DWITH_PLATFORM_SERVER=OFF', '-DUSE_UNWIND=OFF',
            '-DWITH_MANPAGES=OFF', '-DWITH_WEBVIEW=OFF', '-DWITH_SIMD=ON', '-DWITH_SYSTEMD=OFF',
            '-DOPENSSL_INCLUDE_DIR={prefix}/include', # needed so that /usr/include is not added to include path
            '-DCMAKE_MODULE_PATH={prefix}/lib/cmake;{prefix}/lib;{prefix}'
        ]

    # FreeRDP3 gates its SDL clients with WITH_CLIENT_SDL{2,3}, which default to ON as soon as the
    # corresponding SDL is found, so we must explicitly turn them OFF
    freerdp_with_sdl2 = getOption('freerdp.with_sdl2', targetDistribId in ('Darwin', 'mingw',))
    if freerdp_with_sdl2:
        freerdp3_opts += ['-DWITH_CLIENT_SDL2=ON']
        freerdp_deps += ['SDL2-artifact', 'SDL2_image-artifact', 'SDL2_ttf-artifact']
    else:
        freerdp3_opts += ['-DWITH_CLIENT_SDL2=OFF']

    freerdp_with_sdl3 = getOption('freerdp.with_sdl3', True)
    if freerdp_with_sdl3:
        freerdp3_opts += ['-DWITH_CLIENT_SDL3=ON']
        freerdp_deps += ['SDL3-artifact', 'SDL3_ttf-artifact', 'SDL3_image-artifact']
    else:
        freerdp3_opts += ['-DWITH_CLIENT_SDL3=OFF']

    if freerdp_with_sdl2 or freerdp_with_sdl3:
        freerdp3_opts += ['-DWITH_CLIENT_SDL=ON', '-DWITH_SDL_LINK_SHARED=ON']
    else:
        freerdp3_opts += ['-DWITH_CLIENT_SDL=OFF']

    default_fido2 = targetDistribId not in ('mingw',)
    if getOption('freerdp.with_fido2', default_fido2):
        freerdp3_opts += ['-DCHANNEL_RDPEWA=ON', '-DCHANNEL_RDPEWA_CLIENT=ON']
        freerdp_deps += ['fido2-artifact']


    if targetDistribId in ('Windows', 'mingw',):
        FREERDP_opts += ['-DWITH_SHADOW=OFF']

    if targetDistribId == 'Windows':
        # since FreeRDP commit 7f59e0376 wfreerdp-server-cli doesn't link against freerdp-server and winpr
        # anymore and fails to build, so skip the (unmaintained) Windows platform server
        freerdp3_opts += ['-DWITH_PLATFORM_SERVER=OFF']



    #
    # specifies
    #    freerdp2, freerdp2-static, freerdp2-clientOnly, freerdp2-clientOnly-static,
    #    freerdp3, freerdp3-static, freerdp3-clientOnly, freerdp3-clientOnly-static,
    #
    for isStatic in (True, False,):
        provides=['freerdp']

        staticStr = ""
        staticOptions = []
        if isStatic:
            staticOptions = ['-DBUILD_SHARED_LIBS=OFF']
            staticStr = "-static"
            provides.append('freerdp-static')

        options = staticOptions + FREERDP_opts
        ARTIFACTS += [
            CMakeBuildArtifact(f'freerdp2{staticStr}', freerdp_deps,
                GitSource('https://github.com/FreeRDP/FreeRDP.git', 'stable-2.0'),
                options,
                provides=provides + ['freerdp2-artifact'],
                pkgs = {
                    REDHAT_LIKE: freerdp_fedora_redhat_base,
                    UBUNTU_LIKE: freerdp_ubuntu_debian_common
                },
                toolchainArtifacts='c,c++'
            ),

            CMakeBuildArtifact(f'freerdp3{staticStr}', freerdp_deps,
                GitSource('https://github.com/FreeRDP/FreeRDP.git', 'master'),
                options + freerdp3_opts + freerdp_ffmpeg_opts,
                provides=provides + ['freerdp3-artifact'],
                pkgs = {
                    REDHAT_LIKE: freerdp_fedora_redhat_base + ['fuse3-devel'],
                    UBUNTU_LIKE: freerdp_ubuntu_debian_common + ['libfuse3-dev', 'libkrb5-dev'],
                },
                toolchainArtifacts='c,c++'
            ),
        ]
else:
    freerdp2_pkgDeps = {
        UBUNTU_LIKE: ['freerdp2-dev']
    }
    freerdp3_pkgDeps = {
        UBUNTU_LIKE: ['freerdp3-dev']
    }
    ARTIFACTS += [
        DepsBuildArtifact('freerdp2-artifact', [], pkgs=freerdp2_pkgDeps),
        DepsBuildArtifact('freerdp3-artifact', [], pkgs=freerdp3_pkgDeps),
    ]
